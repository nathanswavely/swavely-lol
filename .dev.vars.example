# Copy to .dev.vars for `npm run dev`. Nothing here is real.
ADMIN_EMAILS=homer@example.com
# The host Tools run on locally; each runs on its tile's devPort (src/lib/tools.ts). Production: same origin.
TOOLS_ORIGIN=http://localhost
# '1' sends real mail through Resend in development; otherwise codes are shown on the page.
DEV_SEND_MAIL=0
# Milliseconds to add to every database call, to feel production's round trips (the kit's dev-latency).
DEV_DB_LATENCY_MS=15
