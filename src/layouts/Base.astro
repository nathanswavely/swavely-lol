---
import '../styles/global.css';

/**
 * The Hub's shell: a bar with the mark and who is signed in, the page, a footer. `bare`
 * is the sign-in pages. Textile finish, lol skin; light or dark from the device, or
 * the choice saved by the theme button (Liquid Textile's `lt-theme` key).
 */
interface Props {
  title: string;
  bare?: boolean;
}
const { title, bare = false } = Astro.props;
const viewer = bare ? undefined : Astro.locals.viewer;
---

<!doctype html>
<html lang="en" data-theme="light" data-finish="textile">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title === 'swavely.lol' ? title : `${title} · swavely.lol`}</title>
    <script is:inline>
      (function () {
        var t = null;
        try { t = localStorage.getItem('lt-theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', t);
      })();
    </script>
  </head>
  <body>
    <div class="shell">
      {!bare && (
        <header class="bar">
          <a class="brand" href="/"><img src="/favicon.svg" alt="" width="26" height="26" />swavely.lol</a>
          <div class="who">
            {viewer && <span class="name">{viewer.name}</span>}
            {viewer?.isHubAdmin && <a class="lt-btn lt-btn-ghost lt-btn-sm" href="/people">People</a>}
            <button type="button" class="lt-btn lt-btn-ghost lt-btn-sm" id="theme" aria-label="Switch light or dark">◐</button>
            {viewer && (
              <form method="post" action="/logout">
                <button class="lt-btn lt-btn-ghost lt-btn-sm" type="submit">Sign out</button>
              </form>
            )}
          </div>
        </header>
      )}
      <main>
        <slot />
      </main>
      <footer class="foot">swavely.lol · small tools for family and friends</footer>
    </div>
    <script is:inline>
      (function () {
        var b = document.getElementById('theme');
        if (!b) return;
        b.addEventListener('click', function () {
          var root = document.documentElement;
          var t = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
          root.setAttribute('data-theme', t);
          try { localStorage.setItem('lt-theme', t); } catch (e) {}
        });
      })();
    </script>
  </body>
</html>
