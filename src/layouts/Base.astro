---
import '../styles/global.css';
import Shell from '@swavely-lol/kit/Shell.astro';

/**
 * The Hub's pages in the shell every page on swavely.lol shares (the kit's, ADR-0004):
 * the settings cog with who is signed in, the theme, People for a Hub Admin, and sign
 * in or out; a way home on every page but the Shelf. `bare` is the sign-in pages.
 * `indexed` is the Shelf alone (ADR-0002); every other page asks search engines to stay
 * out.
 */
interface Props {
  title: string;
  bare?: boolean;
  indexed?: boolean;
  /** A wider page, for the Shelf. */
  wide?: boolean;
  /** The Shelf: no way home, since it is home. */
  home?: boolean;
  description?: string;
}
const props = Astro.props;
---

<Shell {...props} canonical={props.indexed ? 'https://swavely.lol/' : undefined}>
  <slot />
</Shell>
