---
import '../styles/global.css';

/**
 * The Hub's shell: a bar with the mark and either who is signed in or a way to sign in,
 * the page, a footer. `bare` is the sign-in pages. `indexed` is the Shelf alone
 * (ADR-0002); every other page asks search engines to stay out. Textile finish, lol
 * skin; light or dark from the device, or the choice saved by the theme button (Liquid
 * Textile's `lt-theme` key).
 */
interface Props {
  title: string;
  bare?: boolean;
  indexed?: boolean;
  /** A wider page, for the Shelf. */
  wide?: boolean;
  description?: string;
}
const { title, bare = false, indexed = false, wide = false, description } = Astro.props;
const viewer = bare ? undefined : Astro.locals.viewer;
const fullTitle = title === 'swavely.lol' ? title : `${title} · swavely.lol`;
---

<!doctype html>
<html lang="en" data-theme="light" data-finish="textile">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content={indexed ? 'index, follow' : 'noindex, nofollow'} />
    <meta name="color-scheme" content="light dark" />
    {description && <meta name="description" content={description} />}
    {indexed && (
      <>
        <link rel="canonical" href="https://swavely.lol/" />
        <meta property="og:title" content={fullTitle} />
        {description && <meta property="og:description" content={description} />}
        <meta property="og:url" content="https://swavely.lol/" />
        <meta property="og:type" content="website" />
      </>
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{fullTitle}</title>
    <script is:inline>
      (function () {
        var t = null;
        try { t = localStorage.getItem('lt-theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', t);
      })();
    </script>
  </head>
  <body>
    <div class="shell">
      {!bare && (
        <header class="bar">
          <a class="brand" href="/"><img src="/favicon.svg" alt="" width="26" height="26" />swavely.lol</a>
          <div class="who">
            {viewer && <span class="name">{viewer.name}</span>}
            {viewer?.isHubAdmin && <a class="lt-btn lt-btn-ghost lt-btn-sm" href="/people">People</a>}
            <button type="button" class="lt-btn lt-btn-ghost lt-btn-sm" id="theme" aria-label="Switch light or dark">◐</button>
            {viewer ? (
              <form method="post" action="/logout">
                <button class="lt-btn lt-btn-ghost lt-btn-sm" type="submit">Sign out</button>
              </form>
            ) : (
              <a class="lt-btn lt-btn-ghost lt-btn-sm" href="/login">Sign in</a>
            )}
          </div>
        </header>
      )}
      <main class={wide ? "wide" : undefined}>
        <slot />
      </main>
      <footer class="foot">Built and run by <a href="https://nathanswavely.com">Nathan Swavely</a> in Lancaster, PA, and the client work lives over at <a href="https://swavelycreative.com">Swavely Creative</a>.</footer>
    </div>
    <script is:inline>
      (function () {
        var b = document.getElementById('theme');
        if (!b) return;
        b.addEventListener('click', function () {
          var root = document.documentElement;
          var t = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
          root.setAttribute('data-theme', t);
          try { localStorage.setItem('lt-theme', t); } catch (e) {}
        });
      })();
    </script>
  </body>
</html>
