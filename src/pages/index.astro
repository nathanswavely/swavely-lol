---
import Base from '../layouts/Base.astro';
import { getEnv } from '../lib/env';
import { TOOLS, isExternal, toolHref } from '../lib/tools';

/**
 * The Shelf (ADR-0002): every Tool as a tile, to anyone. Open Tools go straight in;
 * Invite-only ones carry a lock and ask for sign-in only when opened. Signed in, the
 * same Shelf with a hello.
 */
const env = getEnv();
const viewer = Astro.locals.viewer;
const first = viewer?.name.split(' ')[0];
const host = (href: string) => new URL(href).hostname;
---

<Base title="swavely.lol" indexed description="Small tools by Nathan Swavely: some for anyone, some just for family and friends.">
  <section class="hello">
    <h1 class="page">{first ? `Hi, ${first}.` : 'Small tools, mostly for fun.'}</h1>
    <p class="page-lead">
      {first
        ? 'Everything on the shelf. The ones with a lock are yours to open.'
        : 'Things I made. Some are for anyone; the ones with a lock are for family and friends.'}
    </p>
  </section>

  <ul class="shelf">
    {TOOLS.map((t) => (
      <li>
        <a class={`tile lt-card tile-${t.colour}`} href={toolHref(env, t.href)} {...(isExternal(t) ? { rel: 'noopener' } : {})}>
          <span class="tile-mark" aria-hidden="true">{t.mark}</span>
          <span class="tile-name">{t.name}</span>
          <span class="tile-blurb">{t.blurb}</span>
          <span class="tile-foot">
            {t.soon
              ? <span class="lt-tag lt-tone-warning">Not open yet</span>
              : t.access === 'invite'
                ? <span class="lt-tag lt-tone-muted">🔒 Invite-only</span>
                : <span class="lt-tag lt-tone-success">Open to all</span>}
            {isExternal(t) && <span class="tile-where">{host(t.href)} ↗</span>}
          </span>
        </a>
      </li>
    ))}
  </ul>
</Base>
