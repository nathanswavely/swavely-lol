---
import Base from '../layouts/Base.astro';
import { getEnv } from '../lib/env';
import { PROJECTS, TOOLS, isExternal, toolHref, type Tile } from '../lib/tools';

/**
 * The Shelf (ADR-0002): Tools first, then Projects, as tiles, to anyone. Open ones go
 * straight in; Invite-only ones carry a lock and ask for sign-in only when opened.
 * Signed in or not, the same page.
 */
const env = getEnv();
const host = (href: string) => new URL(href).hostname;
const shelves: { id: string; title: string; tiles: Tile[] }[] = [
  { id: 'tools', title: 'Tools', tiles: TOOLS },
  { id: 'projects', title: 'Projects', tiles: PROJECTS },
];
---

<Base title="swavely.lol" indexed wide description="Tools and projects by Nathan Swavely.">
  <section class="hello">
    <h1 class="page">swavely.lol</h1>
    <p class="page-lead">Tools and projects by Nathan Swavely. More about me at <a href="https://nathanswavely.com">nathanswavely.com</a>, and my work at <a href="https://swavelycreative.com">Swavely Creative</a>.</p>
  </section>

  {shelves.map((s) => (
    <section class="shelf-section" aria-labelledby={s.id}>
      <h2 class="shelf-title" id={s.id}>{s.title}</h2>
      <ul class={`shelf shelf-${s.id}`}>
        {s.tiles.map((t) => (
          <li>
            <a class={`tile lt-card tile-${t.colour}`} href={toolHref(env, t.href)} {...(isExternal(t) ? { rel: 'noopener' } : {})}>
              <span class="tile-mark" aria-hidden="true">{t.mark}</span>
              <span class="tile-name">{t.name}</span>
              <span class="tile-blurb">{t.blurb}</span>
              <span class="tile-foot">
                {t.soon
                  ? <span class="lt-tag lt-tone-warning">Not open yet</span>
                  : t.access === 'invite'
                    ? <span class="lt-tag lt-tone-muted">🔒 Invite-only</span>
                    : <span class="lt-tag lt-tone-success">Open to all</span>}
                {isExternal(t) && <span class="tile-where">{host(t.href)} ↗</span>}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>
