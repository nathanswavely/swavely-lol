---
import Base from '../layouts/Base.astro';
import { getEnv } from '../lib/env';
import { PROJECTS, TOOLS, isExternal, toolHref, type Tile } from '../lib/tools';

/**
 * The Shelf (ADR-0002): Tools first, then Projects, as tiles, to anyone. Open ones go
 * straight in; Invite-only ones carry a lock and ask for sign-in only when opened.
 * Signed in or not, the same page.
 */
const env = getEnv();
const host = (href: string) => new URL(href).hostname;
const shelves: { id: string; title: string; tiles: Tile[] }[] = [
  { id: 'tools', title: 'Tools', tiles: TOOLS },
  { id: 'projects', title: 'Projects', tiles: PROJECTS },
];
---

<Base title="swavely.lol" indexed wide home description="Tools and projects from Nate Swavely.">
  <header class="masthead">
    <h1>swavely.lol</h1>
    <p>Tools and projects from Nate Swavely</p>
  </header>

  {shelves.map((s) => (
    <section class="shelf-section" aria-labelledby={s.id}>
      <h2 class="shelf-title" id={s.id}>{s.title}</h2>
      <ul class={`shelf shelf-${s.id}`}>
        {s.tiles.map((t) => (
          <li>
            <a class={`tile lt-card tile-${t.colour}`} href={toolHref(env, t.href)} {...(isExternal(t) ? { rel: 'noopener' } : {})}>
              <span class="tile-mark" aria-hidden="true">{t.mark}</span>
              <span class="tile-name">{t.name}</span>
              <span class="tile-blurb">{t.blurb}</span>
              <span class="tile-foot">
                {t.soon
                  ? <span class="lt-tag lt-tone-warning">Not open yet</span>
                  : t.access === 'invite'
                    ? <span class="lt-tag lt-tone-muted">🔒 Invite-only</span>
                    : <span class="lt-tag lt-tone-success">Open to all</span>}
                {isExternal(t) && <span class="tile-where">{host(t.href)} ↗</span>}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <footer class="site-foot">
    <p>Hi, I'm Nate. This is where I put the things I make that aren't client work.</p>
    <ul class="foot-links">
      <li><a class="lt-btn" href="https://nathanswavely.com"><span aria-hidden="true">👋</span>nathanswavely.com</a></li>
      <li><a class="lt-btn" href="https://swavelycreative.com"><span aria-hidden="true">🎨</span>Swavely Creative</a></li>
      <li>
        <a class="lt-btn" href="https://github.com/nathanswavely">
          <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path></svg>GitHub
        </a>
      </li>
    </ul>
  </footer>
</Base>
