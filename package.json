{
  "name": "swavely-lol",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --port 4331",
    "build": "astro build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && npm run db:migrate && wrangler deploy",
    "check": "wrangler types && astro check",
    "astro": "astro",
    "postinstall": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply swavely-lol --local",
    "db:migrate": "wrangler d1 migrations apply swavely-lol --remote",
    "db:seed:local": "wrangler d1 execute swavely-lol --local --file scripts/dev-seed.sql"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.4",
    "@fontsource-variable/shantell-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.6.5",
    "typescript": "^6.0.3",
    "wrangler": "4.141.0"
  }
}
